{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cbt-cards.github.io/contracts/practice-semantic-execution-v1.schema.json",
  "title":"CBT Cards practice semantic provider execution v1",
  "type":"object",
  "required":["schema_version","id","provider","requested_model","returned_models","runtime","api_endpoint","eval_manifest_url","eval_manifest_sha256","eval_shards","semantic_case_dataset_sha256","prompt_url","prompt_sha256","skill_url","skill_sha256","context_resources","input_fields","benchmark_fields_hidden","store","web_search_enabled","structured_output","started","completed","response_count","responses_sha256","provider_response_ids"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "id":{"const":"cbt-cards-practice-semantic-execution-v1"},
    "provider":{"type":"string","minLength":1},
    "requested_model":{"type":"string","minLength":1},
    "returned_models":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "runtime":{"type":"string","minLength":1},
    "api_endpoint":{"type":"string","format":"uri"},
    "eval_manifest_url":{"type":"string","format":"uri"},
    "eval_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "eval_shards":{"type":"array","minItems":2,"items":{"type":"object"}},
    "semantic_case_dataset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prompt_url":{"type":"string","format":"uri"},
    "prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "skill_url":{"type":"string","format":"uri"},
    "skill_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "context_resources":{"type":"array","minItems":1,"items":{"type":"object"}},
    "input_fields":{"const":["user_message"]},
    "benchmark_fields_hidden":{"type":"array","minItems":4,"items":{"type":"string"},"uniqueItems":true},
    "store":{"const":false},
    "web_search_enabled":{"const":false},
    "structured_output":{"const":"cbt_cards_practice_semantic_response_v1"},
    "started":{"type":"string"},
    "completed":{"type":"string"},
    "response_count":{"type":"integer","minimum":1},
    "responses_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "provider_response_ids":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}
