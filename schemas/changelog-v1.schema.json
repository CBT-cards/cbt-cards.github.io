{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/changelog-v1.schema.json",
  "title": "CBT Cards public changelog v1",
  "type": "object",
  "required": ["schema_version", "name", "canonical", "updated", "entries"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "canonical": {"const": "https://cbt-cards.github.io/data/changelog.json"},
    "updated": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "date", "scope", "title", "summary", "changes", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "date": {"type": "string", "format": "date"},
          "scope": {"enum": ["website", "app", "data", "agent"]},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "resource_id", "url"],
              "properties": {
                "type": {"enum": ["added", "changed", "removed", "deprecated"]},
                "resource_id": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri"}
              },
              "additionalProperties": false
            }
          },
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
