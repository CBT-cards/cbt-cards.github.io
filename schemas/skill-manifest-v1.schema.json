{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/skill-manifest-v1.schema.json",
  "title": "CBT Cards agent skill manifest v1",
  "type": "object",
  "required": ["schema_version", "name", "homepage", "latest", "latest_url", "updated", "versions"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0"},
    "name": {"const": "cbt-cards"},
    "homepage": {"const": "https://cbt-cards.github.io/agents/"},
    "latest": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "latest_url": {"const": "https://cbt-cards.github.io/agents/cbt-cards/SKILL.md"},
    "updated": {"type": "string", "format": "date"},
    "versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "url"],
        "properties": {
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
