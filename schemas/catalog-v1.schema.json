{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/catalog-v1.schema.json",
  "title": "CBT Cards public resource catalog v1",
  "type": "object",
  "required": ["schema_version", "name", "canonical", "updated", "license", "product", "resources"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "canonical": {"const": "https://cbt-cards.github.io/data/catalog.json"},
    "updated": {"type": "string", "format": "date"},
    "license": {"type": "string", "format": "uri"},
    "product": {
      "type": "object",
      "required": ["id", "name", "homepage", "publisher", "category", "platforms", "medical_scope", "privacy", "support", "stores"],
      "properties": {
        "id": {"const": "cbt-cards"},
        "name": {"type": "string"},
        "homepage": {"type": "string", "format": "uri"},
        "publisher": {"type": "string"},
        "category": {"type": "string"},
        "platforms": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "medical_scope": {"type": "string", "minLength": 1},
        "privacy": {"type": "string", "format": "uri"},
        "support": {"type": "string", "format": "uri"},
        "stores": {
          "type": "object",
          "required": ["android", "ios"],
          "properties": {
            "android": {"type": "string", "format": "uri"},
            "ios": {"type": "string", "format": "uri"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "url", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "type": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "format": {"type": "string"},
          "locale": {"type": "string"},
          "updated": {"type": "string", "format": "date"},
          "reviewed": {"type": "string", "format": "date"},
          "version": {"type": "string"},
          "mutable": {"type": "boolean"},
          "source_dataset": {"type": "string"},
          "source_record_id": {"type": "string"},
          "record_count": {"type": "integer", "minimum": 0},
          "schema_url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
