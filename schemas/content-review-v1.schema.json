{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/content-review-v1.schema.json",
  "title": "CBT Cards content review registry v1",
  "type": "object",
  "required": ["schema_version","id","name","canonical","updated","policy","summary","items"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "id": {"const":"cbt-cards-content-review-v1"},
    "name": {"type":"string","minLength":1},
    "canonical": {"const":"https://cbt-cards.github.io/data/content-review.json"},
    "updated": {"type":"string","format":"date"},
    "policy": {"type":"object","required":["covered_catalog_resource_types","include_owned_practices","review_kind","target_interval_days","overdue_behavior","clinical_validation_status","scope_note"],"properties":{"covered_catalog_resource_types":{"type":"array","items":{"enum":["learning","worksheet","toolkit-card"]},"minItems":3,"uniqueItems":true},"include_owned_practices":{"const":true},"review_kind":{"const":"editorial_source_and_safety"},"target_interval_days":{"type":"integer","minimum":1},"overdue_behavior":{"type":"string","minLength":1},"clinical_validation_status":{"const":"not_claimed"},"scope_note":{"type":"string","minLength":1}},"additionalProperties":false},
    "summary": {"type":"object","required":["covered_items","catalog_resources","owned_practices","next_due"],"properties":{"covered_items":{"type":"integer","minimum":1},"catalog_resources":{"type":"integer","minimum":1},"owned_practices":{"type":"integer","minimum":1},"next_due":{"type":"string","format":"date"}},"additionalProperties":false},
    "items": {"type":"array","minItems":1,"items":{"type":"object","required":["id","kind","content_type","canonical_url","status","last_reviewed","next_review_due","review_scope","reviewed_by","clinical_validation_status"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["catalog_resource","owned_practice"]},"content_type":{"enum":["learning","worksheet","toolkit-card","practice"]},"canonical_url":{"type":"string","format":"uri"},"status":{"const":"reviewed"},"last_reviewed":{"type":"string","format":"date"},"next_review_due":{"type":"string","format":"date"},"review_scope":{"const":"editorial_source_and_safety"},"reviewed_by":{"type":"string","minLength":1},"clinical_validation_status":{"const":"not_claimed"}},"additionalProperties":false}}
  },
  "additionalProperties": false
}
