{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/toolkit-source-v1.schema.json",
  "title": "CBT Cards toolkit source manifest v1",
  "type": "object",
  "required": ["schema_version", "id", "name", "relationship", "version", "language", "record_count", "record_counts", "source_repository", "source_commit", "dataset_blob_sha", "dataset_path", "schema_path", "canonical_dataset_landing_page", "distribution", "media_type", "license", "clinical_review_metadata_present", "cbt_cards_review_overlay", "publication_policy", "quality_notes", "verified"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "relationship": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "record_counts": {
      "type": "object",
      "required": ["card", "metaphor", "protocol"],
      "properties": {
        "card": {"type": "integer", "minimum": 0},
        "metaphor": {"type": "integer", "minimum": 0},
        "protocol": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source_repository": {"type": "string", "format": "uri"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dataset_path": {"type": "string", "minLength": 1},
    "schema_path": {"type": "string", "minLength": 1},
    "canonical_dataset_landing_page": {"type": "string", "format": "uri"},
    "distribution": {"type": "string", "format": "uri"},
    "media_type": {"const": "application/x-ndjson"},
    "license": {"type": "string", "format": "uri"},
    "clinical_review_metadata_present": {"const": false},
    "cbt_cards_review_overlay": {"const": "https://cbt-cards.github.io/data/toolkit-review.json"},
    "publication_policy": {"type": "string", "minLength": 1},
    "quality_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verified": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
