{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbt-cards.github.io/schemas/translation-record-v1.schema.json",
  "title": "CBT Cards translation record v1",
  "description": "Schema for one line/record in data/translations.jsonl.",
  "type": "object",
  "required": ["schema_version", "resource_id", "locale", "source_locale", "source_reviewed", "drafted", "translation_status", "review_status", "publication_status", "canonical_url", "reviewed", "title", "summary", "key_points", "product_relation", "safety_scope"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resource_id": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "source_locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "source_reviewed": {"type": "string", "format": "date"},
    "drafted": {"type": "string", "format": "date"},
    "translation_status": {"enum": ["machine_draft", "human_reviewed"]},
    "review_status": {"enum": ["unreviewed", "reviewed_for_publication"]},
    "publication_status": {"enum": ["not_published", "published"]},
    "canonical_url": {"type": ["string", "null"], "format": "uri"},
    "reviewed": {"type": ["string", "null"], "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "key_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "product_relation": {"type": "string", "minLength": 1},
    "safety_scope": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
